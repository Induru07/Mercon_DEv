{
  "name": "payment-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts",
    "dev": "npm run db:migrate && PORT=$(node -p \"require('fs').readFileSync('.env.local', 'utf8').match(/^PORT=(\\d+)/m)?.[1] || 3000\") next dev",
    "build": "npm run db:migrate && next build",
    "start": "npm run db:migrate && PORT=$(node -p \"require('fs').readFileSync('.env.local', 'utf8').match(/^PORT=(\\d+)/m)?.[1] || 3000\") next start",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "mysql2": "^3.22.5",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
