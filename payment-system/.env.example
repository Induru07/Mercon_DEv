PORT=3005
NODE_ENV=development

# --- Database (MySQL) ---
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mercon

# --- App ---
# Public base URL used to build IPG return/cancel URLs. No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- UoM IPG (CITeS) ---
# Base endpoints for the gateway APIs
UOM_IPG_BASE=
UOM_IPG_INVOICE_BASE=

# Division code and pre-shared token issued by CITeS.
UOM_IPG_DIVISION=TEST
UOM_IPG_TOKEN=
UOM_IPG_CHECKOUT_SCRIPT=

# Authorization header scheme for the IPG token. Default "Bearer".
# Use "none" to send the raw token with no scheme prefix.
UOM_IPG_AUTH_SCHEME=Bearer

# Whether a supplied invoice_id must already exist in the IPG database.
# Confirm the correct value with CITeS for your division (see README).
UOM_IPG_INVOICE_FLAG=true

NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-v2-site-key"
RECAPTCHA_SECRET_KEY="your-v2-secret-key"
# Set to "true" during local development to hide the widget and bypass server validation
NEXT_PUBLIC_BYPASS_RECAPTCHA="false"

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_SECURE=false